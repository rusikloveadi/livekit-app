# Скопируй этот файл в .env (для запуска на своём компьютере) и впиши свои значения.
# На Vercel эти же переменные задаются в Settings → Environment Variables — файл .env туда не попадает.

# ——— Обязательно: сервер видео и чата LiveKit ———
# Бесплатный проект: https://cloud.livekit.io → Settings → API keys.
# Адрес вида wss://имя-проекта.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ——— Необязательно ———
# Сколько человек может быть в одной комнате (по умолчанию 8)
#MAX_PEERS_PER_ROOM=8

# Порт и адрес локального сервера. Без HOST дома слушается только этот компьютер (127.0.0.1).
#PORT=3737
#HOST=127.0.0.1
